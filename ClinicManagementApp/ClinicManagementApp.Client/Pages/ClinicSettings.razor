@* ClinicManagement.Client/Pages/ClinicSettings.razor *@
@page "/clinic-settings"
@inject ClinicManagement.Client.Services.ClinicClientService ClinicService
@inject NavigationManager NavigationManager
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

<div class="row">
    <div class="col-md-8 offset-md-2">
        <h3 class="mb-4"><i class="bi bi-building me-2"></i>Clinic Profile Settings</h3>

        @if (isLoading)
        {
            <p><em>Loading settings...</em></p>
        }
        else
        {
            @if (showSuccessMessage)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    Clinic settings updated successfully! Please refresh the page to see the updated header.
                    <button type="button" class="btn-close" @onclick="() => showSuccessMessage = false"></button>
                </div>
            }

            <div class="card shadow-sm">
                <div class="card-body">
                    <EditForm Model="clinic" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Clinic Name</label>
                            <InputText @bind-Value="clinic.Name" class="form-control form-control-lg" placeholder="e.g. City Health Clinic" />
                            <ValidationMessage For="@(() => clinic.Name)" />
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Landline Number</label>
                                <InputText @bind-Value="clinic.LandlineNumber" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Mobile Number</label>
                                <InputText @bind-Value="clinic.MobileNumber" class="form-control" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Email Address</label>
                            <InputText @bind-Value="clinic.Email" class="form-control" type="email" />
                            <ValidationMessage For="@(() => clinic.Email)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Physical Address</label>
                            <InputTextArea @bind-Value="clinic.Address" class="form-control" rows="2" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Google Maps Embed URL (Optional)</label>
                            <InputText @bind-Value="clinic.GoogleMapLocation" class="form-control" placeholder="Paste map link here..." />
                            <small class="text-muted">This can be used later to display a map on a patient-facing portal.</small>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg">Save Settings</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private ClinicManagement.Shared.DTOs.ClinicDto clinic = new();
    private bool isLoading = true;
    private bool showSuccessMessage = false;

    protected override async Task OnInitializedAsync()
    {
        clinic = await ClinicService.GetClinicDetailsAsync();
        isLoading = false;
    }

    private async Task HandleSubmit()
    {
        await ClinicService.UpdateClinicDetailsAsync(clinic);
        showSuccessMessage = true;
    }
}