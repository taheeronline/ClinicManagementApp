@* ClinicManagement.Client/Pages/Billing/BillingDashboard.razor *@
@page "/billing"
@inject ClinicManagement.Client.Services.BillClientService BillService
@inject ClinicManagement.Client.Services.AppointmentClientService AppointmentService
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

<h3>Receptionist Billing Dashboard</h3>
@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
    </div>
}

@if (isLoading)
{
    <p><em>Loading billing data...</em></p>
}
else
{
    <!-- Section 1: Generate New Bills -->
    <div class="card mb-4 border-primary">
        <div class="card-header bg-primary text-white">
            <strong>Appointments Ready for Billing</strong>
        </div>
        <div class="card-body">
            @if (!completedAppointments.Any())
            {
                <p class="text-muted mb-0">No pending appointments to bill.</p>
            }
            else
            {
                <div class="d-flex align-items-center">
                    <select @bind="selectedAppointmentId" class="form-select me-3" style="max-width: 400px;">
                        <option value="0">-- Select an Appointment to Bill --</option>
                        @foreach (var appt in completedAppointments)
                        {
                            <option value="@appt.Id">@appt.AppointmentDate.ToString("g") - @appt.PatientName (Dr. @appt.DoctorName)</option>
                        }
                    </select>
                    <button class="btn btn-success" @onclick="GenerateBill" disabled="@(selectedAppointmentId == 0)">
                        Generate Invoice
                    </button>
                </div>
            }
        </div>
    </div>

    <!-- Section 2: View All Bills -->
    <div class="card">
        <div class="card-header bg-dark text-white">
            <strong>Invoice History</strong>
        </div>
        <div class="card-body p-0">
            @if (!bills.Any())
            {
                <p class="p-3 text-muted mb-0">No bills have been generated yet.</p>
            }
            else
            {
                <table class="table table-striped mb-0">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Patient</th>
                            <th>Doctor & Speciality</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var bill in bills)
                        {
                            <tr>
                                <td>@bill.BillDate.ToString("g")</td>
                                <td>@bill.PatientName</td>
                                <td>@bill.DoctorName (@bill.DoctorSpeciality)</td>
                                <td><strong>@bill.ConsultationCharge.ToString("C")</strong></td>
                                <td>
                                    @if (bill.IsPaid)
                                    {
                                        <span class="badge bg-success">Paid</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Unpaid</span>
                                    }
                                </td>
                                <td>
                                    @if (!bill.IsPaid)
                                    {
                                        <button class="btn btn-sm btn-outline-success me-2" @onclick="() => HandleMarkAsPaid(bill.Id)">
                                            <i class="bi bi-check-circle"></i> Pay
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => HandleDeleteBill(bill.Id)" title="Cancel Unpaid Invoice">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted"><i class="bi bi-lock-fill text-secondary"></i> Locked</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@code {
    private List<ClinicManagement.Shared.DTOs.ConsultationBillDto> bills = new();
    private List<ClinicManagement.Shared.DTOs.AppointmentDto> completedAppointments = new();
    private int selectedAppointmentId = 0;
    private bool isLoading = true;
    private string errorMessage = string.Empty;


    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;

        // Load all bills
        bills = await BillService.GetBillsAsync();

        // Load ONLY appointments that the doctor has "Completed" but haven't been billed yet
        var allAppointments = await AppointmentService.GetAppointmentsAsync();

        // We filter out appointments that already have a bill generated to avoid duplicates in the dropdown
        var billedAppointmentIds = bills.Select(b => b.AppointmentId).ToList();

        completedAppointments = allAppointments
                    .Where(a => a.Status == ClinicManagement.Shared.Enums.AppointmentStatus.Completed
                             && !billedAppointmentIds.Contains(a.Id))
                    .ToList();

        selectedAppointmentId = 0;
        isLoading = false;
    }

    private async Task GenerateBill()
    {
        if (selectedAppointmentId > 0)
        {
            await BillService.GenerateBillAsync(selectedAppointmentId);
            await LoadData(); // Refresh everything
        }
    }

    private async Task MarkAsPaid(int billId)
    {
        await BillService.MarkAsPaidAsync(billId);
        await LoadData(); // Refresh everything
    }

    private async Task HandleMarkAsPaid(int billId)
    {
        try
        {
            errorMessage = string.Empty;
            await BillService.MarkAsPaidAsync(billId);
            await LoadData();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task HandleDeleteBill(int billId)
    {
        try
        {
            errorMessage = string.Empty;
            await BillService.DeleteBillAsync(billId);
            await LoadData();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }
}