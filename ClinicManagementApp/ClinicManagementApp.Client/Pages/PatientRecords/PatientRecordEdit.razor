@* ClinicManagement.Client/Pages/PatientRecords/PatientRecordEdit.razor *@
@page "/patientrecords/edit/{AppointmentId:int}"
@using Microsoft.AspNetCore.Authorization
@using ClinicManagement.Shared.DTOs
@* STRICT DOCTOR ONLY ACCESS *@
@attribute [Authorize(Roles = "Doctor")]
@inject ClinicManagement.Client.Services.PatientRecordClientService RecordService
@inject NavigationManager NavigationManager
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3><i class="bi bi-clipboard2-pulse text-danger me-2"></i> Active Consultation</h3>
    <a href="/" class="btn btn-outline-secondary">Back to Dashboard</a>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger shadow-sm"><i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage</div>
}

<div class="card shadow-sm border-danger border-top border-4">
    <div class="card-body p-4">
        <EditForm Model="consultation" OnValidSubmit="CompleteConsultation">
            <DataAnnotationsValidator />

            <!-- CLINICAL NOTES -->
            <h5 class="mb-3 text-dark fw-bold border-bottom pb-2">Clinical Notes</h5>
            <div class="mb-3">
                <label class="form-label fw-bold">Symptoms Observed <span class="text-danger">*</span></label>
                <InputTextArea @bind-Value="consultation.Symptoms" class="form-control" rows="3" placeholder="Describe the patient's symptoms..." />
                <ValidationMessage For="@(() => consultation.Symptoms)" class="text-danger small" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Official Diagnosis <span class="text-danger">*</span></label>
                <InputText @bind-Value="consultation.Diagnosis" class="form-control fw-bold text-danger" placeholder="e.g., Acute Bronchitis" />
                <ValidationMessage For="@(() => consultation.Diagnosis)" class="text-danger small" />
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold">Additional Notes & Advice</label>
                <InputTextArea @bind-Value="consultation.AdditionalNotes" class="form-control" rows="2" placeholder="Rest for 3 days, drink plenty of fluids..." />
            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-end gap-3 mt-4">
                <button type="button" class="btn btn-light border" @onclick="() => NavigationManager.NavigateTo(NavigationManager.Uri, true)">Reset Form</button>
                <button type="submit" class="btn btn-danger px-4 fw-bold" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    <i class="bi bi-check-circle me-1"></i> Complete Consultation
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter]
    public int AppointmentId { get; set; }

    // Using the ConsultationSaveDto you configured in your API
    private ConsultationSaveDto consultation = new();
    private bool isSubmitting = false;
    private string errorMessage = string.Empty;

    protected override void OnInitialized()
    {
        // Bind the appointment ID from the URL to the DTO
        consultation.AppointmentId = AppointmentId;
    }

    private async Task CompleteConsultation()
    {
        try
        {
            isSubmitting = true;
            errorMessage = string.Empty;

            // This hits your custom endpoint: "api/patientrecords/complete-consultation"
            await RecordService.CompleteConsultationAsync(consultation);

            // Once the consultation is complete, send the Doctor back to their dashboard
            NavigationManager.NavigateTo("/");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save consultation: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}