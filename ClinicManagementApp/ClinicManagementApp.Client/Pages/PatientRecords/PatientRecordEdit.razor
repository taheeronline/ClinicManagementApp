@* ClinicManagement.Client/Pages/PatientRecords/PatientRecordEdit.razor *@
@page "/patientrecords/edit"
@page "/patientrecords/edit/{AppointmentId:int}"
@inject ClinicManagement.Client.Services.PatientRecordClientService RecordService
@inject ClinicManagement.Client.Services.AppointmentClientService AppointmentService
@inject NavigationManager NavigationManager
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3><i class="bi bi-file-medical text-primary"></i> Doctor's Consultation Dashboard</h3>
    <a href="/" class="btn btn-outline-secondary">Cancel & Go Back</a>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
    </div>
}

@if (isLoading)
{
    <p><em>Loading consultation details...</em></p>
}
else
{
    <!-- Locked Context Info (Replaces the Dropdown) -->
    <div class="card shadow-sm mb-4 border-primary">
        <div class="card-body bg-light">
            <div class="row text-center">
                <div class="col-md-4">
                    <small class="text-muted d-block">Patient Name</small>
                    <span class="fs-5 fw-bold text-dark">@appointmentDetails?.PatientName</span>
                </div>
                <div class="col-md-4">
                    <small class="text-muted d-block">Doctor</small>
                    <span class="fs-5 fw-bold text-dark">Dr. @appointmentDetails?.DoctorName</span>
                </div>
                <div class="col-md-4">
                    <small class="text-muted d-block">Appointment Time</small>
                    <span class="fs-5 fw-bold text-dark">@appointmentDetails?.AppointmentDate.ToString("f")</span>
                </div>
            </div>
        </div>
    </div>

    <EditForm Model="consultation" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />

        <div class="card mb-4 shadow-sm border-info">
            <div class="card-header bg-info text-white fw-bold">1. Clinical Notes</div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label fw-bold">Symptoms</label>
                    <InputTextArea @bind-Value="consultation.Symptoms" class="form-control" rows="2" placeholder="Describe patient symptoms..." />
                    <ValidationMessage For="@(() => consultation.Symptoms)" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold text-primary">Diagnosis</label>
                    <InputText @bind-Value="consultation.Diagnosis" class="form-control border-primary form-control-lg" placeholder="Final diagnosis..." />
                    <ValidationMessage For="@(() => consultation.Diagnosis)" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Additional Notes (Optional)</label>
                    <InputTextArea @bind-Value="consultation.AdditionalNotes" class="form-control" rows="2" />
                </div>
            </div>
        </div>

        <div class="card mb-4 shadow-sm border-warning">
            <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center fw-bold">
                <span>2. Prescriptions</span>
                <button type="button" class="btn btn-sm btn-dark" @onclick="AddMedicineRow">+ Add Medicine</button>
            </div>
            <div class="card-body">
                @if (consultation.Prescriptions.Count == 0)
                {
                    <p class="text-muted mb-0">No medicines added yet. Click "+ Add Medicine" to prescribe.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Medicine</th>
                                    <th>Dosage</th>
                                    <th>Duration</th>
                                    <th>Instructions</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var med in consultation.Prescriptions)
                                {
                                    <tr>
                                        <td><InputText @bind-Value="med.MedicineName" class="form-control form-control-sm" placeholder="Name" /></td>
                                        <td><InputText @bind-Value="med.Dosage" class="form-control form-control-sm" placeholder="e.g. 500mg" /></td>
                                        <td><InputText @bind-Value="med.Duration" class="form-control form-control-sm" placeholder="e.g. 5 Days" /></td>
                                        <td><InputText @bind-Value="med.Instructions" class="form-control form-control-sm" placeholder="e.g. After food" /></td>
                                        <td class="text-end"><button type="button" class="btn btn-sm btn-danger" @onclick="() => RemoveMedicineRow(med)"><i class="bi bi-trash"></i></button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <button type="submit" class="btn btn-success btn-lg w-100 shadow-sm"><i class="bi bi-check-circle me-2"></i>Complete Consultation & Send to Billing</button>
    </EditForm>
}

@code {
    [Parameter]
    public int? AppointmentId { get; set; } // Passed from the Dashboard URL

    private ClinicManagement.Shared.DTOs.ConsultationSaveDto consultation = new();
    private ClinicManagement.Shared.DTOs.AppointmentDto? appointmentDetails;

    private bool isLoading = true;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (!AppointmentId.HasValue)
        {
            // If they navigate here without clicking a specific appointment, kick them back
            NavigationManager.NavigateTo("/");
            return;
        }

        try
        {
            // Fetch appointment details to display in the read-only header
            appointmentDetails = await AppointmentService.GetAppointmentByIdAsync(AppointmentId.Value);

            // SECURITY: Ensure they are not trying to consult on an already finished/cancelled appointment
            if (appointmentDetails.Status != ClinicManagement.Shared.Enums.AppointmentStatus.Scheduled)
            {
                NavigationManager.NavigateTo("/");
                return;
            }

            // Auto-bind the hidden IDs for the submission DTO
            consultation.AppointmentId = appointmentDetails.Id;
            consultation.PatientId = appointmentDetails.PatientId;
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to load appointment details. It may have been deleted.";
        }

        isLoading = false;
    }

    private void AddMedicineRow()
    {
        consultation.Prescriptions.Add(new ClinicManagement.Shared.DTOs.PrescriptionItemDto());
    }

    private void RemoveMedicineRow(ClinicManagement.Shared.DTOs.PrescriptionItemDto item)
    {
        consultation.Prescriptions.Remove(item);
    }

    private async Task HandleSubmit()
    {
        try
        {
            errorMessage = string.Empty;

            // Note: Make sure CompleteConsultationAsync uses the HandleErrorsAsync pattern in the Client Service!
            await RecordService.CompleteConsultationAsync(consultation);

            // Route back to Dashboard so the receptionist/doctor sees it hit the Billing Queue instantly
            NavigationManager.NavigateTo("/");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }
}