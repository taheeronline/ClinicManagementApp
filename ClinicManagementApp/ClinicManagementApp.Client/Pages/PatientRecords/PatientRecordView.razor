@* ClinicManagement.Client/Pages/PatientRecords/PatientRecordView.razor *@
@page "/patientrecords/view/{Id:int}"
@inject ClinicManagement.Client.Services.PatientRecordClientService RecordService
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3><i class="bi bi-lock-fill text-secondary me-2"></i>Official Medical Record</h3>
    <a href="/patientrecords" class="btn btn-outline-secondary">Back to List</a>
</div>

@if (isLoading)
{
    <p><em>Loading secured record...</em></p>
}
else
{
    <div class="card mb-4 border-secondary shadow-sm">
        <div class="card-header bg-secondary text-white d-flex justify-content-between">
            <span><strong>Patient:</strong> @record.PatientName</span>
            <span><strong>Doctor:</strong> Dr. @record.DoctorName</span>
            <span><strong>Date:</strong> @record.DateAdded.ToString("f")</span>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <h6 class="fw-bold text-muted border-bottom pb-1">Symptoms</h6>
                <p>@record.Symptoms</p>
            </div>
            <div class="mb-3">
                <h6 class="fw-bold text-muted border-bottom pb-1">Diagnosis</h6>
                <p class="fs-5 text-dark fw-semibold">@record.Diagnosis</p>
            </div>
            @if (!string.IsNullOrWhiteSpace(record.AdditionalNotes))
            {
                <div class="mb-3">
                    <h6 class="fw-bold text-muted border-bottom pb-1">Additional Notes</h6>
                    <p>@record.AdditionalNotes</p>
                </div>
            }
        </div>
    </div>

    <h4 class="mb-3"><i class="bi bi-capsule me-2"></i>Prescriptions Issued</h4>
    @if (record.Prescriptions.Count == 0)
    {
        <div class="alert alert-light border">No medications were prescribed during this consultation.</div>
    }
    else
    {
        <div class="table-responsive shadow-sm">
            <table class="table table-bordered table-striped bg-white mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Medicine Name</th>
                        <th>Dosage</th>
                        <th>Duration</th>
                        <th>Instructions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var med in record.Prescriptions)
                    {
                        <tr>
                            <td class="fw-bold">@med.MedicineName</td>
                            <td>@med.Dosage</td>
                            <td>@med.Duration</td>
                            <td>@med.Instructions</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    [Parameter]
    public int Id { get; set; }

    private ClinicManagement.Shared.DTOs.PatientRecordDetailsDto record = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        record = await RecordService.GetRecordDetailsAsync(Id);
        isLoading = false;
    }
}