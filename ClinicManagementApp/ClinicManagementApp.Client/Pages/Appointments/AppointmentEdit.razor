@page "/appointments/edit"
@page "/appointments/edit/{Id:int}"
@inject ClinicManagement.Client.Services.AppointmentClientService AppointmentService
@inject ClinicManagement.Client.Services.DoctorClientService DoctorService
@inject ClinicManagement.Client.Services.PatientClientService PatientService
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,Manager,Receptionist")]
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

<h3>@(Id.HasValue ? "Edit Appointment" : "Book Appointment")</h3>

@if (isLoading)
{
    <p><em>Loading form data...</em></p>
}
else
{
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mb-4">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
        </div>
    }
    <EditForm Model="appointment" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="row">
            <div class="col-md-6 mb-3">
                <label>Select Patient</label>
                <InputSelect @bind-Value="appointment.PatientId" class="form-select">
                    <option value="0">-- Select a Patient --</option>
                    @foreach (var p in patients)
                    {
                        <option value="@p.Id">@p.FullName</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => appointment.PatientId)" />
            </div>

            <div class="col-md-6 mb-3">
                <label>Select Doctor</label>
                <InputSelect @bind-Value="appointment.DoctorId" class="form-select">
                    <option value="0">-- Select a Doctor --</option>
                    @foreach (var d in doctors)
                    {
                        <option value="@d.Id">@d.FullName (@d.Speciality)</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => appointment.DoctorId)" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label>Appointment Date & Time</label>
                <!-- Type="datetime-local" renders a clean calendar/clock picker in HTML5 -->
                <InputDate Type="InputDateType.DateTimeLocal" @bind-Value="appointment.AppointmentDate" class="form-control" />
                <ValidationMessage For="@(() => appointment.AppointmentDate)" />
            </div>
        </div>

        <div class="mb-3">
            <label>Reason for Visit</label>
            <InputTextArea @bind-Value="appointment.ReasonForVisit" class="form-control" rows="3" />
            <ValidationMessage For="@(() => appointment.ReasonForVisit)" />
        </div>

        <button type="submit" class="btn btn-success">Save Appointment</button>
        <a href="/appointments" class="btn btn-secondary">Cancel</a>
    </EditForm>
}

@code {
    [Parameter]
    public int? Id { get; set; }

    private ClinicManagement.Shared.DTOs.AppointmentDto appointment = new();
    private List<ClinicManagement.Shared.DTOs.DoctorDto> doctors = new();
    private List<ClinicManagement.Shared.DTOs.PatientDto> patients = new();
    private bool isLoading = true;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        doctors = await DoctorService.GetDoctorsAsync();
        patients = await PatientService.GetPatientsAsync();

        if (Id.HasValue)
        {
            appointment = await AppointmentService.GetAppointmentByIdAsync(Id.Value);

            // --- UPDATED BUSINESS RULE #1: PREVENT DIRECT URL ACCESS ---
            // If the appointment is NOT Scheduled (i.e. Cancelled, NoShow, Completed, Closed)
            if (appointment.Status != ClinicManagement.Shared.Enums.AppointmentStatus.Scheduled)
            {
                // Kick them back to the appointments list
                NavigationManager.NavigateTo("/appointments");
                return;
            }
            // -----------------------------------------------------------
        }
        else
        {
            // Default new appointments to tomorrow
            appointment.AppointmentDate = DateTime.Now.AddDays(1);
        }

        isLoading = false;
    }

    private async Task HandleSubmit()
    {
        errorMessage = string.Empty; // Clear any previous errors

        try
        {
            if (Id.HasValue)
            {
                await AppointmentService.UpdateAppointmentAsync(Id.Value, appointment);
            }
            else
            {
                await AppointmentService.CreateAppointmentAsync(appointment);
            }

            NavigationManager.NavigateTo("/appointments"); // Only navigate if successful!
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message; // Display the double-booking error on the screen
        }
    }
}