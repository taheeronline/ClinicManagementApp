@page "/appointments"
@inject ClinicManagement.Client.Services.AppointmentClientService AppointmentService
@inject ClinicManagement.Client.Services.LoadingService LoadingService
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3><i class="bi bi-calendar-check text-primary me-2"></i> All Appointments</h3>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
    </div>
}

<!-- ACTION BAR: Button and Search side-by-side -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <a href="/appointments/edit" class="btn btn-primary fw-bold shadow-sm">+ Book New Appointment</a>
    <div class="d-flex gap-2 align-items-center">
        <div class="input-group shadow-sm">
            <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
            <input type="text" class="form-control border-start-0" placeholder="Search by patient, doctor, or status..."
                   value="@searchTerm" @oninput="OnSearchChanged" aria-label="Search appointments" />
        </div>
        <div class="d-flex gap-1 align-items-center">
            <input type="date" class="form-control form-control-sm" @bind="fromDate" @bind:event="oninput" @onchange="ApplyFilters" title="From date" />
            <button class="btn btn-outline-secondary btn-sm" @onclick="ClearDateFilters" title="Clear date filters">Clear</button>
        </div>
    </div>
</div>

@if (appointments == null)
{
    <div class="d-flex justify-content-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (!filteredAppointments.Any())
{
    <div class="alert alert-light border text-center text-muted p-5">
        <i class="bi bi-search fs-1 d-block mb-3"></i>
        No appointments found matching your search.
    </div>
}
else
{
    <!-- SCROLLABLE CONTAINER -->
    <div class="table-responsive border rounded shadow-sm" style="max-height: 500px; overflow-y: auto;">
        <table class="table table-hover table-striped mb-0 align-middle">
            <thead class="table-dark sticky-top">
                <tr>
                    <th>Date & Time</th>
                    <th>Patient</th>
                    <th>Doctor</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var appt in filteredAppointments)
                {
                    <tr>
                        <td class="fw-bold">@appt.AppointmentDate.ToString("g")</td>
                        <td>@appt.PatientName</td>
                        <td>Dr. @appt.DoctorName</td>
                        <td>
                            <span class="badge @GetStatusBadgeClass(appt.Status)">
                                @appt.Status.ToString()
                            </span>
                        </td>
                        <td class="text-end">
                            @if (appt.Status == ClinicManagement.Shared.Enums.AppointmentStatus.Scheduled)
                            {
                                <a href="/appointments/edit/@appt.Id" class="btn btn-sm btn-outline-warning me-1" title="Edit Appointment">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button @onclick="() => CancelAppointment(appt.Id)" class="btn btn-sm btn-outline-danger" title="Cancel Appointment">
                                    <i class="bi bi-x-circle"></i> Cancel
                                </button>
                            }
                            else
                            {
                                <span class="text-muted small" title="Completed/Closed/Cancelled appointments cannot be modified">
                                    <i class="bi bi-lock-fill text-secondary"></i> Locked
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<ClinicManagement.Shared.DTOs.AppointmentDto>? appointments;
    private List<ClinicManagement.Shared.DTOs.AppointmentDto> filteredAppointments = new();
    private string searchTerm = string.Empty;
    private string errorMessage = string.Empty;
    private DateTime? fromDate;

    protected override async Task OnInitializedAsync()
    {
        await LoadAppointments();
    }

    private async Task LoadAppointments()
    {
        appointments = await AppointmentService.GetAppointmentsAsync();

        // Apply filter immediately so it respects the search bar after a cancel operation
        ApplyFilters();
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        var list = appointments ?? new List<ClinicManagement.Shared.DTOs.AppointmentDto>();

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            list = list.Where(a => a.PatientName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                                   a.DoctorName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                                   a.Status.ToString().Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
                       .ToList();
        }

        if (fromDate.HasValue)
        {
            list = list.Where(a => a.AppointmentDate.Date >= fromDate.Value.Date).ToList();
        }

        filteredAppointments = list;
    }

    private void ClearDateFilters()
    {
        fromDate = null;
        ApplyFilters();
    }

    private async Task CancelAppointment(int id)
    {
        try
        {
            errorMessage = string.Empty;
            LoadingService.Show("Cancelling appointment...");
            await AppointmentService.CancelAppointmentAsync(id);
            await LoadAppointments(); // Refresh list on success
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    private string GetStatusBadgeClass(ClinicManagement.Shared.Enums.AppointmentStatus status) => status switch
    {
        ClinicManagement.Shared.Enums.AppointmentStatus.Scheduled => "bg-primary",
        ClinicManagement.Shared.Enums.AppointmentStatus.Completed => "bg-success",
        ClinicManagement.Shared.Enums.AppointmentStatus.Cancelled => "bg-danger",
        ClinicManagement.Shared.Enums.AppointmentStatus.NoShow => "bg-secondary",
        _ => "bg-dark"
    };
}