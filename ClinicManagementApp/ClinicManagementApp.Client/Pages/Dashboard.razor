@* ClinicManagement.Client/Pages/Dashboard.razor *@
@page "/"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using ClinicManagementApp.Client.Pages
@using ClinicManagementApp.Client.Pages.Doctors
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

<PageTitle>Clinic Dashboard</PageTitle>

<AuthorizeView>
    <Authorized>
        @if (isCheckingRoles)
        {
            <div class="d-flex flex-column align-items-center justify-content-center mt-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-3 text-muted">Loading your workspace...</p>
            </div>
        }
        else if (isDoctor)
        {
            <DoctorDashboard/>
        }
        else if (isStaff)
        {
            <StaffDashboard/>
        }
        else if (isAdmin)
        {
            <AdminDashboard/>
        }
        else
        {
            <!-- DIAGNOSTIC FALLBACK: If we get here, it means we couldn't match the role -->
            <div class="alert alert-warning mt-4 shadow-sm container">
                <h4><i class="bi bi-exclamation-triangle"></i> Workspace Not Found</h4>
                <p>We see you are successfully logged in as <strong>@context.User.Identity?.Name</strong>, but we couldn't match your role to a specific dashboard.</p>
                <hr />
                <p class="mb-1"><strong>Roles found in your token:</strong></p>
                <ul>
                    @foreach (var claim in context.User.Claims.Where(c => c.Type == ClaimTypes.Role || c.Type == "role"))
                    {
                        <li>@claim.Value</li>
                    }
                </ul>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <ClinicManagement.Client.Pages.RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private bool isCheckingRoles = true;
    private bool isDoctor = false;
    private bool isStaff = false;
    private bool isAdmin = false;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask != null)
        {
            var authState = await AuthStateTask;
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                // We check claims manually to completely ignore Case-Sensitivity (Doctor vs doctor)
                var userRoles = user.Claims
                                    .Where(c => c.Type == ClaimTypes.Role || c.Type == "role")
                                    .Select(c => c.Value)
                                    .ToList();

                isDoctor = userRoles.Contains("Doctor", StringComparer.OrdinalIgnoreCase);
                
                isStaff = userRoles.Contains("Manager", StringComparer.OrdinalIgnoreCase) || 
                          userRoles.Contains("Receptionist", StringComparer.OrdinalIgnoreCase);
                
                isAdmin = userRoles.Contains("Admin", StringComparer.OrdinalIgnoreCase);
            }
        }
        
        isCheckingRoles = false;
    }
}