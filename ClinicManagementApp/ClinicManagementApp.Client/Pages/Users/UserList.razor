@* ClinicManagement.Client/Pages/Users/UserList.razor *@
@page "/users"
@inject ClinicManagement.Client.Services.UserClientService UserService
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

<h3><i class="bi bi-shield-lock text-danger me-2"></i> System Users (Staff)</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
    </div>
}

<AuthorizeView Roles="Admin">
    <Authorized>
        <a href="/users/edit" class="btn btn-primary mb-3 shadow-sm">+ Register New User</a>
    </Authorized>
</AuthorizeView>

@if (users == null)
{
    <div class="d-flex justify-content-center my-5">
        <div class="spinner-border text-danger" role="status"></div>
    </div>
}
else if (!users.Any())
{
    <p class="text-muted">No users found in the system.</p>
}
else
{
    <div class="table-responsive border rounded shadow-sm">
        <table class="table table-hover table-striped mb-0 align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Login</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Last Login</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in users)
                {
                    <tr>
                        <td class="fw-bold">@user.Name</td>
                        <td>@user.LoginName</td>
                        <td><span class="badge bg-info text-dark shadow-sm">@user.Role</span></td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td class="text-muted small">@(user.LastLogin?.ToString("g") ?? "Never")</td>
                        <td class="text-end">
                            <a href="/users/edit/@user.Id" class="btn btn-sm btn-outline-primary me-1">Edit</a>
                            <button @onclick="() => DeleteUser(user.Id)" class="btn btn-sm btn-outline-danger">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<ClinicManagement.Shared.DTOs.UserDto>? users;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        users = await UserService.GetUsersAsync();
    }

    private async Task DeleteUser(int id)
    {
        try
        {
            errorMessage = string.Empty;
            await UserService.DeleteUserAsync(id);
            await LoadUsers();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }
}