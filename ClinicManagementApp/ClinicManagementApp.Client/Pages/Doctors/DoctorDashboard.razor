@using ClinicManagement.Shared.DTOs
@using System.Security.Claims
@inject ClinicManagement.Client.Services.AppointmentClientService AppointmentService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<div class="alert alert-info shadow-sm mt-3">
    <h4><i class="bi bi-person-badge"></i> Doctor Portal</h4>
    <p class="mb-0">Welcome to your workspace, <strong>@doctorName</strong>.</p>
</div>

@if (isLoading)
{
    <div class="d-flex flex-column align-items-center justify-content-center mt-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-3 text-muted">Loading your schedule...</p>
    </div>
}
else
{
    <div class="card mt-4 shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-calendar-day"></i> My Schedule for Today</h5>
            <small class="text-white-50">@todaysAppointments.Count appointment(s)</small>
        </div>
        <div class="card-body">
            @if (!todaysAppointments.Any())
            {
                <div class="text-muted text-center py-4">
                    <i class="bi bi-calendar-x fs-3 d-block mb-2"></i>
                    <p>No appointments scheduled for today.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Time</th>
                                <th>Patient Name</th>
                                <th>Status</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appt in todaysAppointments)
                            {
                                <tr>
                                    <td>
                                        <strong>@appt.AppointmentDate.ToString("hh:mm tt")</strong>
                                    </td>
                                    <td>
                                        @appt.PatientName
                                    </td>
                                    <td>
                                        <span class="badge @GetStatusBadgeClass(appt.Status)">@appt.Status.ToString()</span>
                                    </td>
                                    <td class="text-center">
                                        @if (appt.Status == ClinicManagement.Shared.Enums.AppointmentStatus.Scheduled)
                                        {
                                            <!-- Consult button for scheduled appointments -->
                                            <a href="/patientrecords/edit/@appt.Id" class="btn btn-sm btn-success" title="Start Consultation">
                                                <i class="bi bi-stethoscope me-1"></i> Consult
                                            </a>
                                        }
                                        else if (appt.Status == ClinicManagement.Shared.Enums.AppointmentStatus.Completed)
                                        {
                                            <!-- View button for completed appointments -->
                                            <a href="/patientrecords/view/@appt.Id" class="btn btn-sm btn-outline-secondary" title="View Consultation Record">
                                                <i class="bi bi-eye me-1"></i> Review
                                            </a>
                                        }
                                        else
                                        {
                                            <!-- View button for other statuses -->
                                            <a href="/appointments/edit/@appt.Id" class="btn btn-sm btn-outline-secondary" title="View Appointment Details">
                                                <i class="bi bi-info-circle me-1"></i> View
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private string doctorName = "Doctor";
    private List<AppointmentDto> todaysAppointments = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            doctorName = user.Identity.Name ?? "Doctor";
            var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier) ?? user.FindFirst("sub");

            if (userIdClaim != null && int.TryParse(userIdClaim.Value, out int doctorId))
            {
                var allAppointments = await AppointmentService.GetAppointmentsAsync();
                todaysAppointments = allAppointments
                    .Where(a => a.DoctorId == doctorId && a.AppointmentDate.Date == DateTime.Today)
                    .OrderBy(a => a.AppointmentDate)
                    .ToList();
            }
        }
        isLoading = false;
    }

    private string GetStatusBadgeClass(ClinicManagement.Shared.Enums.AppointmentStatus status)
    {
        return status switch
        {
            ClinicManagement.Shared.Enums.AppointmentStatus.Scheduled => "bg-success",
            ClinicManagement.Shared.Enums.AppointmentStatus.Completed => "bg-info",
            ClinicManagement.Shared.Enums.AppointmentStatus.Cancelled => "bg-danger",
            ClinicManagement.Shared.Enums.AppointmentStatus.NoShow => "bg-warning",
            _ => "bg-secondary"
        };
    }
}