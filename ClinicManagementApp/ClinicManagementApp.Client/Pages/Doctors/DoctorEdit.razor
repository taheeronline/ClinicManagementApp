@page "/doctors/edit"
@page "/doctors/edit/{Id:int}"
@inject ClinicManagement.Client.Services.DoctorClientService DoctorService
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.Authorization
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

<h3>@(Id.HasValue ? "Edit Doctor" : "Add New Doctor")</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
    </div>
}

<EditForm Model="doctor" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />

    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-primary text-white">Professional Details</div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">First Name</label>
                    <InputText @bind-Value="doctor.FirstName" class="form-control" />
                    <ValidationMessage For="@(() => doctor.FirstName)" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Last Name</label>
                    <InputText @bind-Value="doctor.LastName" class="form-control" />
                    <ValidationMessage For="@(() => doctor.LastName)" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">Speciality</label>
                    <InputText @bind-Value="doctor.Speciality" class="form-control" />
                    <ValidationMessage For="@(() => doctor.Speciality)" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Consultation Fee</label>
                    <InputNumber @bind-Value="doctor.ConsultationFee" class="form-control" />
                    <ValidationMessage For="@(() => doctor.ConsultationFee)" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Phone Number</label>
                    <InputText @bind-Value="doctor.PhoneNumber" class="form-control" />
                    <ValidationMessage For="@(() => doctor.PhoneNumber)" />
                </div>
            </div>
        </div>
    </div>

    <!-- NEW SECTION: ACCOUNT CREDENTIALS -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-dark text-white">Login Credentials</div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Login Username *</label>
                    <InputText @bind-Value="doctor.LoginName" class="form-control" />
                    <ValidationMessage For="@(() => doctor.LoginName)" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Password @(Id.HasValue ? "(Leave blank to keep current)" : "*")</label>
                    <InputText @bind-Value="doctor.Password" type="password" class="form-control" />
                    @if (!Id.HasValue && string.IsNullOrWhiteSpace(doctor.Password))
                    {
                        <span class="text-danger small">Password is required for new doctors.</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-success me-2">Save Doctor</button>
    <a href="/doctors" class="btn btn-secondary">Cancel</a>
</EditForm>

@code {
    [Parameter]
    public int? Id { get; set; }

    private ClinicManagement.Shared.DTOs.DoctorDto doctor = new();
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            try
            {
                doctor = await DoctorService.GetDoctorByIdAsync(Id.Value);
            }
            catch (Exception ex)
            {
                errorMessage = ex.Message;
            }
        }
    }

    private async Task HandleSubmit()
    {
        try
        {
            errorMessage = string.Empty;

            // Manual check for password on creation
            if (!Id.HasValue && string.IsNullOrWhiteSpace(doctor.Password))
            {
                errorMessage = "Password is required for new doctors.";
                return;
            }

            if (Id.HasValue)
            {
                await DoctorService.UpdateDoctorAsync(Id.Value, doctor);
            }
            else
            {
                await DoctorService.CreateDoctorAsync(doctor);
            }

            NavigationManager.NavigateTo("/doctors");
        }
        catch (Exception ex)
        {
            // This catches the Duplicate Username error from the API!
            errorMessage = ex.Message;
        }
    }
}