@inject ClinicManagement.Client.Services.ClinicClientService ClinicService
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm" style="z-index: 1000;">
    <div class="container-fluid px-4">

        <!-- BRAND & CLINIC NAME -->
        <a class="navbar-brand d-flex align-items-center" href="/">
            <i class="bi bi-heart-pulse-fill text-danger fs-4 me-2"></i>
            <span class="fw-bold">CMS for @clinicName</span>
        </a>

        <!-- MOBILE TOGGLE BUTTON -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#clinicNavBar">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- NAVIGATION LINKS -->
        <div class="collapse navbar-collapse" id="clinicNavBar">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-2 ms-4">
                <li class="nav-item">
                    <a class="nav-link text-white hover-highlight" href="/"><i class="bi bi-house-door me-1"></i>Dashboard</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white hover-highlight" href="/doctors"><i class="bi bi-person-badge me-1"></i>Doctors</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white hover-highlight" href="/patients"><i class="bi bi-people me-1"></i>Patients</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white hover-highlight" href="/appointments"><i class="bi bi-calendar-check me-1"></i>Appointments</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white hover-highlight" href="/patientrecords"><i class="bi bi-clipboard2-pulse me-1"></i>Records</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white hover-highlight" href="/billing"><i class="bi bi-cash-stack me-1"></i>Billing</a>
                </li>
            </ul>

            <!-- SETTINGS ICON -->
            <div class="d-flex">
                <a href="/clinic-settings" class="btn btn-outline-light btn-sm d-flex align-items-center" title="Clinic Settings">
                    <i class="bi bi-gear-fill me-2"></i> Settings
                </a>
            </div>
        </div>
    </div>
</nav>

<style>
    .hover-highlight:hover {
        color: #17a2b8 !important; /* Changes to a nice blue on hover */
        transition: color 0.2s ease-in-out;
    }
</style>

@code {
    private string clinicName = "Loading...";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var clinic = await ClinicService.GetClinicDetailsAsync();

            // If the database returns empty, use a fallback name
            clinicName = string.IsNullOrWhiteSpace(clinic?.Name) ? "My Clinic" : clinic.Name;
        }
        catch (Exception ex)
        {
            // If the API fails (e.g. table not found), we catch the error so the UI doesn't freeze
            Console.WriteLine($"Error fetching clinic data: {ex.Message}");
            clinicName = "My Clinic (Setup Required)";
        }
    }
}