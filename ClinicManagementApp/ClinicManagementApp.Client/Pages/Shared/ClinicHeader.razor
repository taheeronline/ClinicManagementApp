@inject ClinicManagement.Client.Services.ClinicClientService ClinicService
@inject ClinicManagement.Client.Services.AuthClientService AuthService
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.Components.Authorization
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm" style="z-index: 1000;">
    <div class="container-fluid px-4">

        <!-- BRAND & SETTINGS (Left Side) -->
        <div class="d-flex align-items-center me-4">
            <a href="/clinic-settings" class="btn btn-outline-light btn-sm me-3" title="Clinic Settings">
                <i class="bi bi-gear-fill"></i>
            </a>
            <a class="navbar-brand d-flex align-items-center m-0" href="/">
                <i class="bi bi-heart-pulse-fill text-danger fs-4 me-2"></i>
                <span class="fw-bold">CMS for @clinicName</span>
            </a>
        </div>

        <!-- RIGHT SIDE ACTIONS (Auth) -->
        <div class="d-flex align-items-center ms-auto gap-3">
            <AuthorizeView>
                <Authorized>
                    <span class="text-white fw-bold me-2">@context.User.Identity?.Name</span>
                    <button class="btn btn-danger btn-sm shadow-sm d-flex align-items-center" @onclick="Logout">
                        <i class="bi bi-box-arrow-right me-1"></i> Logout
                    </button>
                </Authorized>
                <NotAuthorized>
                    <a href="/login" class="btn btn-primary btn-sm shadow-sm d-flex align-items-center">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Login
                    </a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

    </div>
</nav>

@code {
    private string clinicName = "Loading...";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var clinic = await ClinicService.GetClinicDetailsAsync();
            clinicName = string.IsNullOrWhiteSpace(clinic?.Name) ? "My Clinic" : clinic.Name;
        }
        catch (Exception)
        {
            clinicName = "My Clinic (Setup Required)";
        }
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("/login", forceLoad: true);
    }
}