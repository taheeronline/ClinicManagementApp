@using ClinicManagement.Shared.DTOs
@using System.Security.Claims
@inject ClinicManagement.Client.Services.AppointmentClientService AppointmentService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<div class="container-fluid py-3">
    <!-- Header & Quick Actions -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2><i class="bi bi-front me-2 text-primary"></i> Front Desk Operations</h2>
            <p class="text-muted mb-0">Welcome, <strong>@staffName</strong> | @DateTime.Today.ToString("dddd, MMMM dd, yyyy")</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/patients/edit" class="btn btn-outline-primary shadow-sm">
                <i class="bi bi-person-plus me-1"></i> New Patient
            </a>
            <a href="/appointments/edit" class="btn btn-primary shadow-sm">
                <i class="bi bi-calendar-plus me-1"></i> Book Appointment
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
        </div>
    }

    @if (isLoading)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
        <!-- KPI Row -->
        <div class="row mb-4">
            <div class="col-md-3 col-sm-6 mb-3 mb-md-0">
                <div class="card bg-white border-primary border-start border-5 h-100 shadow-sm">
                    <div class="card-body">
                        <h6 class="text-muted text-uppercase fw-bold mb-2">Total Today</h6>
                        <h2 class="mb-0 text-dark">@todaysAppointments.Count</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6 mb-3 mb-md-0">
                <div class="card bg-white border-warning border-start border-5 h-100 shadow-sm">
                    <div class="card-body">
                        <h6 class="text-muted text-uppercase fw-bold mb-2">Scheduled</h6>
                        <h2 class="mb-0 text-dark">@todaysAppointments.Count(a => a.Status == ClinicManagement.Shared.Enums.AppointmentStatus.Scheduled)</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6 mb-3 mb-md-0">
                <div class="card bg-white border-success border-start border-5 h-100 shadow-sm">
                    <div class="card-body">
                        <h6 class="text-muted text-uppercase fw-bold mb-2">Completed</h6>
                        <h2 class="mb-0 text-dark">@todaysAppointments.Count(a => a.Status == ClinicManagement.Shared.Enums.AppointmentStatus.Completed || a.Status == ClinicManagement.Shared.Enums.AppointmentStatus.Closed)</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="card bg-white border-danger border-start border-5 h-100 shadow-sm">
                    <div class="card-body">
                        <h6 class="text-muted text-uppercase fw-bold mb-2">Cancellations/No-Shows</h6>
                        <h2 class="mb-0 text-dark">@todaysAppointments.Count(a => a.Status == ClinicManagement.Shared.Enums.AppointmentStatus.Cancelled || a.Status == ClinicManagement.Shared.Enums.AppointmentStatus.NoShow)</h2>
                    </div>
                </div>
            </div>
        </div>

        <!-- Master Schedule for Today -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white p-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i> Today's Master Schedule</h5>
                <a href="/appointments" class="btn btn-sm btn-outline-light">View All Dates</a>
            </div>
            <div class="card-body p-0">
                @if (!todaysAppointments.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-calendar-x fs-1 d-block mb-3"></i>
                        <h5>No appointments booked for today.</h5>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="px-4">Time</th>
                                    <th>Patient Name</th>
                                    <th>Doctor</th>
                                    <th>Status</th>
                                    <th class="text-end px-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var appt in todaysAppointments)
                                {
                                    <tr>
                                        <td class="px-4">
                                            <strong>@appt.AppointmentDate.ToString("hh:mm tt")</strong>
                                        </td>
                                        <td>
                                            <div class="fw-bold text-dark">@appt.PatientName</div>
                                        </td>
                                        <td>
                                            <span class="text-muted"><i class="bi bi-person-badge me-1"></i> @appt.DoctorName</span>
                                        </td>
                                        <td>
                                            <span class="badge @GetStatusBadgeClass(appt.Status)">@appt.Status.ToString()</span>
                                        </td>
                                        <td class="text-end px-4">
                                            <div class="btn-group">
                                                <a href="/appointments/edit/@appt.Id" class="btn btn-sm btn-outline-secondary" title="Edit Appointment">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                @if (appt.Status == ClinicManagement.Shared.Enums.AppointmentStatus.Completed)
                                                {
                                                    <!-- Link directly to billing for completed appointments -->
                                                    <a href="/billing" class="btn btn-sm btn-outline-success" title="Go to Billing">
                                                        <i class="bi bi-receipt"></i> Bill
                                                    </a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private string errorMessage = string.Empty;
    private string staffName = "Staff Member";
    private List<AppointmentDto> todaysAppointments = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadStaffDashboardAsync();
    }

    private async Task LoadStaffDashboardAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                staffName = user.Identity.Name ?? "Staff Member";

                // Fetch ALL appointments, but filter only for today's date
                var allAppointments = await AppointmentService.GetAppointmentsAsync();
                
                todaysAppointments = allAppointments
                    .Where(a => a.AppointmentDate.Date == DateTime.Today)
                    .OrderBy(a => a.AppointmentDate)
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load dashboard data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetStatusBadgeClass(ClinicManagement.Shared.Enums.AppointmentStatus status) => status switch
    {
        ClinicManagement.Shared.Enums.AppointmentStatus.Scheduled => "bg-primary",
        ClinicManagement.Shared.Enums.AppointmentStatus.Completed => "bg-success",
        ClinicManagement.Shared.Enums.AppointmentStatus.Closed => "bg-secondary",
        ClinicManagement.Shared.Enums.AppointmentStatus.Cancelled => "bg-danger",
        ClinicManagement.Shared.Enums.AppointmentStatus.NoShow => "bg-dark",
        _ => "bg-light text-dark"
    };
}